# Copy to .env.local and fill in from Supabase: Project Settings → API (Project URL and the anon/publishable key).
# The anon key is meant for the browser; row level security in supabase/schema.sql protects the data.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key
